{
  "name": "penfoldbot",
  "version": "2.0.0",
  "description": "Your personal assistant on Discord",
  "keywords": [
    "penfoldbot",
    "penfold",
    "danger",
    "mouse"
  ],
  "homepage": "https://github.com/penfoldium/penfoldbot#readme",
  "bugs": {
    "url": "https://github.com/penfoldium/penfoldbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penfoldium/penfoldbot.git"
  },
  "license": "MIT",
  "author": "Penfoldium",
  "type": "module",
  "main": "src/bot.js",
  "scripts": {
    "build": "rm -rf dist && npx tsc && cp -R ./src/Locales/* ./dist/src/Locales/",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format:check": "npx prettier . --check",
    "format:write": "npx prettier . --write",
    "start": "npm run build && node --env-file .env dist/src/Penfold",
    "start:dev": "npm run build && node --env-file dev.env dist/src/Penfold",
    "prisma:init": "npx prisma migrate deploy &&  npx prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bufferutil": "^4.1.0",
    "chrono-node": "^2.9.0",
    "dayjs": "^1.11.19",
    "discord.js": "^14.25.1",
    "i18next": "^25.7.3",
    "i18next-fs-backend": "^2.6.1",
    "ms": "^2.1.3",
    "nekos.life": "^3.0.0",
    "node-cron": "^4.2.1",
    "parse-duration": "^2.1.5",
    "timezones-list": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.7.4",
    "prisma": "^7.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
