// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

datasource db {
  provider = "sqlite"
}

model UserSettings {
  id          Int    @id @unique
  timezone    String @default("Etc/UTC")
  dailyDmTime String @default("8AM")
}
